# Copy to .env (git ignores it). On Render, set these in the Environment tab.
OPENAI_API_KEY=
STRIPE_SECRET_KEY=       # sandbox key only (sk_test_...). The app refuses a live key.
DATABASE_URL=            # Postgres, e.g. Neon, with sslmode=require
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=          # any long random string
LULU_CLIENT_KEY=         # Lulu Print API, sandbox only: developers.sandbox.lulu.com/user-profile/api-keys
LULU_CLIENT_SECRET=

# Optional
# PRINT_CENTS=2499                         # price of a printed copy, standard US shipping included
# ADMIN_EMAILS=you@example.com              # who sees /#/admin (default: the first account)
# PUBLISHER="Bluebid Books"                # printed on the copyright page and back cover
# BOOK_IMAGE_MODEL=gpt-image-2.5-flare     # the face pass, per book (fast)
# BOOK_IMAGE_QUALITY=medium
# SCENE_IMAGE_MODEL=gpt-image-2.5-sunburst # pre-generated art
# SCENE_IMAGE_QUALITY=high
# IMAGE_CONCURRENCY=24
# PREGEN=off                               # don't generate the bible and scenes at startup
# PREGEN_MAX=200                           # most image calls one startup may spend

# Local testing only
# MOCK_IMAGES=1
# DEV_LOGIN=1
# PGSSL=0
# STRIPE_API_HOST=localhost  STRIPE_API_PORT=12111  STRIPE_API_PROTOCOL=http
